    "version": "0.2.0",
    "configurations": [
        //-- apps/user_app
        {
            "name": "user_app -> development",
            "cwd": "apps/user_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_development.dart",
            "args": [
                "--flavor",
                "development",
                "--target",
                "lib/main_development.dart"
            ]
        },
        {
            "name": "user_app -> staging",
            "cwd": "apps/user_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_staging.dart",
            "args": [
                "--flavor",
                "staging",
                "--target",
                "lib/main_staging.dart"
            ]
        },
        {
            "name": "user_app -> production",
            "cwd": "apps/user_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_production.dart",
            "args": [
                "--flavor",
                "production",
                "--target",
                "lib/main_production.dart"
            ]
        },
        //-- apps/admin_app
        {
            "name": "admin_app -> development",
            "cwd": "apps/admin_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_development.dart",
            "args": [
                "--flavor",
                "development",
                "--target",
                "lib/main_development.dart"
            ]
        },
        {
            "name": "admin_app -> staging",
            "cwd": "apps/admin_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_staging.dart",
            "args": [
                "--flavor",
                "staging",
                "--target",
                "lib/main_staging.dart"
            ]
        },
        {
            "name": "admin_app -> production",
            "cwd": "apps/admin_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_production.dart",
            "args": [
                "--flavor",
                "production",
                "--target",
                "lib/main_production.dart"
            ]
        },
        //-- packages/utils
        {
            "name": "utils",
            "cwd": "packages/utils",
            "request": "launch",
            "type": "dart"
        }
    ]
}